import os
import re
import shutil
import pandas as pd
from pathlib import Path

# ============================================================
# CONFIGURATION
# ============================================================

# Folder containing the downloaded NEON data
INPUT_DIR = Path(r"D:\NEON_Water_Data")

# Folder where sorted data will be created
OUTPUT_DIR = Path(r"D:\NEON_Water_Sorted")

OUTPUT_DIR.mkdir(parents=True, exist_ok=True)


# ============================================================
# FILES WE ACTUALLY WANT
# ============================================================

# Useful measurement/data files
USEFUL_FILES = [
    "swc_fieldData",
    "swc_externalLabDataByAnalyte",
    "swc_domainLabData",
    "swc_asiPOMFieldData"
]

# Files that are definitely NOT useful for the ML dataset
IGNORE_KEYWORDS = [
    "categoricalCodes",
    "validation",
    "variables",
    "readme",
    "EML",
    "manifest",
    "externalLabBlanks",
    "externalLabSummaryData"
]


# ============================================================
# FIND SITE ID FROM DATA
# ============================================================

def find_site_column(df):

    possible_columns = [
        "siteID",
        "siteId",
        "site_id",
        "site",
        "namedLocation",
        "namedLocationID",
        "domainID"
    ]

    # Exact matches first
    for col in possible_columns:
        if col in df.columns:
            return col

    # Case-insensitive search
    lower_columns = {
        str(col).lower(): col
        for col in df.columns
    }

    for col in possible_columns:
        if col.lower() in lower_columns:
            return lower_columns[col.lower()]

    # Fallback: search for columns containing "site"
    for col in df.columns:
        if "site" in str(col).lower():
            return col

    return None


# ============================================================
# EXTRACT SITE ID FROM NEON FOLDER / FILE NAME
# ============================================================

def extract_site_from_path(file_path):

    # Example:
    # NEON.D01.HOPB.DP1.20093.001...
    #
    # We want:
    # D01_HOPB

    match = re.search(
        r"NEON\.(D\d{2})\.([A-Z0-9]+)\.",
        file_path.name
    )

    if match:
        domain = match.group(1)
        site = match.group(2)

        return f"{domain}_{site}"

    return None


# ============================================================
# CHECK WHETHER CSV IS USEFUL
# ============================================================

def is_useful_csv(file_path):

    filename = file_path.name.lower()

    # Must be CSV
    if file_path.suffix.lower() != ".csv":
        return False

    # Ignore metadata/support files
    for keyword in IGNORE_KEYWORDS:
        if keyword.lower() in filename:
            return False

    # Check whether it is one of our useful datasets
    for useful_name in USEFUL_FILES:
        if useful_name.lower() in filename:
            return True

    return False


# ============================================================
# PROCESS FILES
# ============================================================

processed = 0
skipped = 0

for csv_file in INPUT_DIR.rglob("*.csv"):

    # --------------------------------------------------------
    # Ignore metadata/support CSVs
    # --------------------------------------------------------

    if not is_useful_csv(csv_file):
        skipped += 1
        continue

    print(f"\nProcessing:")
    print(csv_file)

    try:

        # ----------------------------------------------------
        # Read CSV
        # ----------------------------------------------------

        df = pd.read_csv(
            csv_file,
            low_memory=False
        )

        if df.empty:
            print("  -> Empty CSV, skipped")
            skipped += 1
            continue

        # ----------------------------------------------------
        # Find site column
        # ----------------------------------------------------

        site_column = find_site_column(df)

        # ----------------------------------------------------
        # If site ID exists inside CSV
        # ----------------------------------------------------

        if site_column is not None:

            site_ids = (
                df[site_column]
                .dropna()
                .astype(str)
                .str.strip()
                .unique()
            )

            # Remove empty values
            site_ids = [
                site for site in site_ids
                if site
            ]

        else:

            # ------------------------------------------------
            # Fall back to site ID from filename
            # ------------------------------------------------

            site_from_filename = extract_site_from_path(csv_file)

            if site_from_filename:
                site_ids = [site_from_filename]
            else:
                print("  -> Site ID not found, skipped")
                skipped += 1
                continue

        # ----------------------------------------------------
        # Sort data into site folders
        # ----------------------------------------------------

        for site_id in site_ids:

            # Clean folder name
            safe_site = re.sub(
                r'[<>:"/\\|?*]',
                "_",
                site_id
            )

            site_folder = OUTPUT_DIR / safe_site

            site_folder.mkdir(
                parents=True,
                exist_ok=True
            )

            # ------------------------------------------------
            # If CSV contains multiple sites,
            # keep only rows belonging to this site
            # ------------------------------------------------

            if site_column is not None:

                site_df = df[
                    df[site_column]
                    .astype(str)
                    .str.strip()
                    == site_id
                ].copy()

            else:

                site_df = df.copy()

            if site_df.empty:
                continue

            # ------------------------------------------------
            # Create output filename
            # ------------------------------------------------

            output_file = site_folder / csv_file.name

            # ------------------------------------------------
            # Save
            # ------------------------------------------------

            site_df.to_csv(
                output_file,
                index=False
            )

            print(
                f"  -> {safe_site}: "
                f"{len(site_df)} rows"
            )

        processed += 1

    except Exception as e:

        print(f"  -> ERROR: {e}")
        skipped += 1


# ============================================================
# SUMMARY
# ============================================================

print("\n===================================")
print("PROCESSING COMPLETE")
print("===================================")

print(f"Useful CSVs processed : {processed}")
print(f"Files skipped         : {skipped}")
print(f"Output directory      : {OUTPUT_DIR}")
